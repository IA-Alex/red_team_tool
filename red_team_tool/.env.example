# Proveedor LLM: DeepInfra (https://deepinfra.com)
DEEPINFRA_API_KEY=your_deepinfra_api_key_here
# Modelo en formato compatible con DeepInfra (el prefijo deepinfra/ es opcional)
LLM_MODEL=google/gemma-2-27b-it

# API key exigida (cabecera X-API-Key) para los endpoints POST del panel web.
# Si se deja vacío, la API queda sin autenticación (solo recomendable en
# desarrollo local, sirviendo en 127.0.0.1).
REDTEAMCREW_API_KEY=

# Poner en "1" solo si la API corre detrás de un proxy/load balancer de
# confianza que fija X-Forwarded-For de forma fiable. Habilita que el rate
# limit use esa cabecera en vez de la IP del socket TCP (la del proxy). Si se
# activa sin un proxy real delante, cualquier cliente puede falsificar su IP
# y evadir el límite.
REDTEAMCREW_TRUST_PROXY=0

# Ruta del fichero SQLite donde se persisten los engagements de la API.
REDTEAMCREW_DB=outputs/engagements.db

# Raíz de confianza desde la que la fase de análisis puede escanear código
# local (--code-path en la CLI). Si se deja vacío, el escaneo de código local
# queda deshabilitado.
REDTEAMCREW_SCAN_ROOT=

# URL de Redis usada por la API y el worker (cola de trabajos + stream de
# eventos SSE). Requiere `redis-server` corriendo.
REDTEAMCREW_REDIS_URL=redis://localhost:6379

# Activa/desactiva el reconocimiento y análisis ACTIVO (nmap/nuclei) contra el
# alcance autorizado. En "0" el flujo sigue funcionando solo con OSINT pasivo.
REDTEAMCREW_ACTIVE_RECON=1
